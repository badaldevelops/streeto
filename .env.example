# Copy to .env (never commit the real file) and fill in your own values.
# Production secrets live in Cloudflare (SESSION_SECRET, VAPID_PRIVATE_KEY),
# not in files.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Random 32+ byte secret for signing session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Browser-exposed Google Maps key. Restrict it by HTTP referrer and by API
# in Google Cloud Console, because NEXT_PUBLIC_ values ship to every visitor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
