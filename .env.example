# Copy to .env (never commit the real file) and fill in your own values.
# Production secrets live in Cloudflare (SESSION_SECRET, VAPID_PRIVATE_KEY),
# not in files.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Random 32+ byte secret for signing session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Browser-exposed Google Maps key. Restrict it by HTTP referrer and by API
# in Google Cloud Console, because NEXT_PUBLIC_ values ship to every visitor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cashfree Payment Gateway: start with sandbox credentials and switch mode only
# after the Cashfree account is approved for production payments.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_MODE="sandbox"

# Brevo transactional email: keep the API key in Cloudflare Worker secrets.
BREVO_API_KEY=""
# 32-byte encryption key encoded as 64 hex characters; keep this in Cloudflare secrets in production.
BUSINESS_KYC_ENCRYPTION_KEY=""
PASSWORD_RESET_FROM="no-reply@mail.qtoo.in"
