generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  outlets   Outlet[]
  products  Product[]
  users     User[]
}

model Outlet {
  id                String          @id @default(cuid())
  name              String
  address           String?
  phone             String?
  latitude          Float?
  longitude         Float?
  deliveryRadiusKm  Float           @default(5)
  businessType      String          @default("FIXED_SHOP")
  locationUpdatedAt DateTime?
  deliveryCharge    Float           @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  companyId         String
  orders            Order[]
  company           Company         @relation(fields: [companyId], references: [id])
  outletProducts    OutletProduct[]
  users             User[]
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String?
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String?
  outletId     String?
  addresses    Address[]
  deliveries   Delivery[] @relation("DeliveryStaff")
  orders       Order[]    @relation("CustomerOrders")
  company      Company?   @relation(fields: [companyId], references: [id])
  outlet       Outlet?    @relation(fields: [outletId], references: [id])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companyId      String
  orderItems     OrderItem[]
  outletProducts OutletProduct[]
  company        Company         @relation(fields: [companyId], references: [id])
}

model OutletProduct {
  id          String   @id @default(cuid())
  price       Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  outletId    String
  productId   String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([outletId, productId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  type              OrderType
  status            OrderStatus @default(PLACED)
  subtotal          Float
  deliveryCharge    Float       @default(0)
  total             Float
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customerId        String?
  outletId          String
  deliveryAddress   String?
  customerPhone     String?
  customerName      String?
  customerLatitude  Float?
  customerLongitude Float?
  businessType      String      @default("FIXED_SHOP")
  locationUpdatedAt DateTime?
  queueNumber       Int?
  queuePosition     Int?
  delivery          Delivery?
  customer          User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  outlet            Outlet      @relation(fields: [outletId], references: [id])
  items             OrderItem[]
  payment           Payment?
}

model OrderItem {
  id         String  @id @default(cuid())
  quantity   Int
  unitPrice  Float
  totalPrice Float
  orderId    String
  productId  String
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
}

model Delivery {
  id              String    @id @default(cuid())
  status          String
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  orderId         String    @unique
  deliveryStaffId String?
  deliveryStaff   User?     @relation("DeliveryStaff", fields: [deliveryStaffId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  fullName    String
  phone       String
  addressLine String
  landmark    String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_ADMIN
  CUSTOMER
  DELIVERY_STAFF
}

enum OrderType {
  DELIVERY
  SELF_RECEIVE
  COUNTER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  UPI
  OTHER
}
