generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                       String                     @id @default(cuid())
  name                     String
  upiId                    String?
  isActive                 Boolean                    @default(true)
  isOpen                   Boolean                    @default(true)
  verificationStatus       BusinessVerificationStatus @default(APPROVED)
  foodLicenseNumber        String?
  foodLicenseExpiry        DateTime?
  ownerAadhaarCiphertext   String?
  ownerAadhaarLast4        String?
  verificationSubmittedAt  DateTime?
  verificationReviewedAt   DateTime?
  verificationReviewedById String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  outlets                  Outlet[]
  products                 Product[]
  users                    User[]
  pushSubscriptions        BusinessPushSubscription[]
  commissionCollections    CommissionCollection[]
}

model Outlet {
  id                   String                @id @default(cuid())
  name                 String
  city                 String?
  locality             String?
  address              String?
  phone                String?
  latitude             Float?
  longitude            Float?
  deliveryRadiusKm     Float                 @default(5)
  businessType         String                @default("FIXED_SHOP")
  foodType             String                @default("BOTH")
  locationUpdatedAt    DateTime?
  deliveryCharge       Float                 @default(0)
  deliveryEnabled      Boolean               @default(false)
  gstin                String?
  cashfreeVendorId     String?               @unique
  cashfreeVendorStatus String?
  cashfreeVendorLast4  String?
  cashfreeVendorIfsc   String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  companyId            String
  orders               Order[]
  ratings              OutletRating[]
  payoutRequests       OutletPayoutRequest[]
  company              Company               @relation(fields: [companyId], references: [id])
  outletProducts       OutletProduct[]
  users                User[]
}

model User {
  id                  String                     @id @default(cuid())
  name                String
  email               String                     @unique
  phone               String?
  passwordHash        String?
  role                UserRole
  isActive            Boolean                    @default(true)
  sessionVersion      Int                        @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  companyId           String?
  outletId            String?
  addresses           Address[]
  deliveries          Delivery[]                 @relation("DeliveryStaff")
  orders              Order[]                    @relation("CustomerOrders")
  outletRatings       OutletRating[]
  company             Company?                   @relation(fields: [companyId], references: [id])
  outlet              Outlet?                    @relation(fields: [outletId], references: [id])
  pushSubscriptions   BusinessPushSubscription[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BusinessPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

model PlatformSettings {
  id              String   @id @default("global")
  deliveryEnabled Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companyId      String
  orderItems     OrderItem[]
  outletProducts OutletProduct[]
  company        Company         @relation(fields: [companyId], references: [id])
}

model OutletProduct {
  id          String   @id @default(cuid())
  category    String   @default("Other")
  addOns      Json     @default("[]")
  price       Float
  sgstRate    Float    @default(0)
  cgstRate    Float    @default(0)
  isAvailable Boolean  @default(true)
  isVeg       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  outletId    String
  productId   String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([outletId, productId])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  type                  OrderType
  status                OrderStatus   @default(PLACED)
  subtotal              Float
  sgstAmount            Float         @default(0)
  cgstAmount            Float         @default(0)
  gstin                 String?
  deliveryCharge        Float         @default(0)
  total                 Float
  platformCommission    Float         @default(0)
  platformCommissionGst Float         @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  customerId            String?
  outletId              String
  deliveryAddress       String?
  customizationNote     String?
  customerPhone         String?
  customerName          String?
  customerLatitude      Float?
  customerLongitude     Float?
  businessType          String        @default("FIXED_SHOP")
  locationUpdatedAt     DateTime?
  queueNumber           Int?
  queuePosition         Int?
  delivery              Delivery?
  customer              User?         @relation("CustomerOrders", fields: [customerId], references: [id])
  outlet                Outlet        @relation(fields: [outletId], references: [id])
  items                 OrderItem[]
  payment               Payment?
  rating                OutletRating?
}

model OutletRating {
  id         String   @id @default(cuid())
  stars      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  outletId   String
  customerId String
  orderId    String   @unique
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([outletId, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  addOns     Json    @default("[]")
  quantity   Int
  unitPrice  Float
  totalPrice Float
  sgstAmount Float   @default(0)
  cgstAmount Float   @default(0)
  orderId    String
  productId  String
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                    String               @id @default(cuid())
  amount                Float
  method                PaymentMethod
  status                PaymentStatus        @default(PENDING)
  transactionId         String?
  upiReference          String?
  upiPayeeId            String?
  upiPayeeName          String?
  gatewayOrderId        String?              @unique
  gatewaySessionId      String?
  outletPayoutStatus    String               @default("PENDING")
  outletPayoutReference String?
  outletPayoutAt        DateTime?
  outletPayoutRequestId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  orderId               String               @unique
  order                 Order                @relation(fields: [orderId], references: [id])
  outletPayoutRequest   OutletPayoutRequest? @relation(fields: [outletPayoutRequestId], references: [id], onDelete: SetNull)

  @@index([outletPayoutRequestId])
}

model OutletPayoutRequest {
  id                String    @id @default(cuid())
  outletId          String
  amount            Float
  status            String    @default("PENDING")
  utr               String?
  requestedAt       DateTime  @default(now())
  paidAt            DateTime?
  requestedByUserId String
  paidByUserId      String?
  outlet            Outlet    @relation(fields: [outletId], references: [id], onDelete: Restrict)
  payments          Payment[]

  @@index([outletId, status, requestedAt])
  @@index([status, requestedAt])
}

model CommissionCollection {
  id          String   @id @default(cuid())
  companyId   String
  amount      Float
  reference   String?
  note        String?
  collectedAt DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, collectedAt])
}

model Delivery {
  id              String    @id @default(cuid())
  status          String
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  orderId         String    @unique
  deliveryStaffId String?
  deliveryStaff   User?     @relation("DeliveryStaff", fields: [deliveryStaffId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  fullName    String
  phone       String
  addressLine String
  landmark    String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_ADMIN
  CUSTOMER
  DELIVERY_STAFF
}

enum BusinessVerificationStatus {
  PENDING
  APPROVED
}

enum OrderType {
  DELIVERY
  SELF_RECEIVE
  DINE_IN
  COUNTER
}

enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  UPI
  OTHER
}
